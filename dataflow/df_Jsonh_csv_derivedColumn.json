{
	"name": "df_Jsonh_csv_derivedColumn",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "jsonHealthTech",
						"type": "DatasetReference"
					},
					"name": "srcHealthTechJsonData"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_HealthTech_FlattenedDC",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumnUnrollDepts"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Company as string,",
				"          Departments as (Employees as (ID as short, Name as string, Role as string)[], Name as string)[]",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     documentForm: 'singleDocument') ~> srcHealthTechJsonData",
				"srcHealthTechJsonData derive(Dept_Names = flatten(array(Departments.Name)),",
				"          Employee_ID = flatten(array(Departments.Employees.ID)),",
				"          Emp_name = flatten(array(Departments.Employees.Name)),",
				"          Role = flatten(array(Departments.Employees.Role)),",
				"     partitionBy('hash', 1)) ~> derivedColumnUnrollDepts",
				"derivedColumnUnrollDepts sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          Company as string,",
				"          Dept_Name as string,",
				"          Emp_ID as string,",
				"          Emp_Name as string,",
				"          Role as string",
				"     ),",
				"     partitionFileNames:['Flattened_HealthTech.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     mapColumn(",
				"          Company,",
				"          Dept_Name = Departments",
				"     ),",
				"     partitionBy('hash', 1)) ~> sink1"
			]
		}
	}
}