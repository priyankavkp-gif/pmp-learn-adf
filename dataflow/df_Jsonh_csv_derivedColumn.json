{
	"name": "df_Jsonh_csv_derivedColumn",
	"properties": {
		"folder": {
			"name": "DF_JSON_CSV_FilesConversion"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "jsonHealthTech",
						"type": "DatasetReference"
					},
					"name": "srcHealthTechJsonData"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_HealthTech_FlattenedDC",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumnUnrollDepts"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Company as string,",
				"          Department as string,",
				"          Employees_Details as (ID as string, Name as string, Role as string)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     documentForm: 'arrayOfDocuments',",
				"     partitionBy('hash', 1)) ~> srcHealthTechJsonData",
				"srcHealthTechJsonData derive(Emp_ID = Employees_Details.ID,",
				"          Emp_Name = Employees_Details.Name,",
				"          Role = Employees_Details.Role,",
				"     partitionBy('hash', 1)) ~> derivedColumnUnrollDepts",
				"derivedColumnUnrollDepts sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          Company as string,",
				"          Dept_Name as string,",
				"          Emp_ID as string,",
				"          Emp_Name as string,",
				"          Role as string",
				"     ),",
				"     partitionFileNames:['Flattened_HealthTech.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     mapColumn(",
				"          Company,",
				"          Dept_Name = Department,",
				"          Emp_ID,",
				"          Emp_Name,",
				"          Role",
				"     ),",
				"     partitionBy('hash', 1)) ~> sink1"
			]
		}
	}
}